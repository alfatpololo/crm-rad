NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# Service account for Admin SDK (Server side) - JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# App URL (wajib di production = URL depan HTTPS yang sama dengan domain cookie login, termasuk callback Doku)
# Di Vercel jika kosong, fallback ke VERCEL_URL (bisa beda dari domain custom — lebih aman set manual)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Doku Payment Gateway (Back Office → kredensial API; untuk signature pakai Secret Key / Shared Key yang dipasangkan Client ID)
DOKU_CLIENT_ID=your_client_id
DOKU_SECRET_KEY=your_secret_key
# true | 1 | yes — hanya memanggil https://api.doku.com (tidak dicampur sandbox)
DOKU_IS_PRODUCTION=true

# Cloudinary (upload gambar kelas & produk)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default

# Resend (email: QR kehadiran, blast promo). Supaya email masuk inbox: verifikasi domain di resend.com/domains, pakai RESEND_FROM dari domain itu
RESEND_API_KEY=re_your_api_key_here
# Dari mana email dikirim (wajib domain yang sudah diverifikasi di Resend, atau onboarding@resend.dev hanya untuk testing ke email Anda)
# RESEND_FROM=CRM <noreply@domain-anda.com>

# Mekari/Qontak WhatsApp omnichannel (broadcast direct)
MEKARI_WA_TOKEN=your_token_dari_dashboard_qontak
MEKARI_WA_CHANNEL_ID=your_channel_id_wa
MEKARI_WA_TEMPLATE_ID=your_template_id_wa
# Base URL default: https://api.mekari.com
# MEKARI_WA_BASE_URL=https://api.mekari.com
# Cron: secret untuk /api/cron/wa-reminders?secret=xxx
# CRON_SECRET=

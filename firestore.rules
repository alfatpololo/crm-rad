rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@mail.com';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Services collection - allow read for authenticated users, write only for admin
    match /services/{serviceId} {
      allow read: if isAuthenticated(); // Allow all authenticated users to read services
      allow write: if isAdmin(); // Only admin can create/update/delete services
    }
    
    // Products collection - same rules as services
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Participants collection
    match /participants/{participantId} {
      // User can read their own data, admin can read all
      allow read: if isAuthenticated() && (isOwner(participantId) || isAdmin());
      // User can update their own data
      allow create, update: if isAuthenticated() && isOwner(participantId);
      // Only admin can delete
      allow delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // Invoices collection
    match /invoices/{invoiceId} {
      // User can read invoices where they are the client, admin can read all
      allow read: if isAuthenticated() && (
        resource.data.client.email == request.auth.token.email || 
        isAdmin()
      );
      // Only admin can create/update invoices
      allow write: if isAdmin();
    }
    
    // Default: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}






